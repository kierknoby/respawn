[Unit]
Description=Respawn Pond isolated PHP-FPM
After=network.target

[Service]
Type=simple
User=respawn-pond
Group=www-data
SupplementaryGroups=respawn-pond
RuntimeDirectory=respawn-pond
RuntimeDirectoryMode=0750
ExecStart=/usr/sbin/php-fpm8.4 --nodaemonize --fpm-config @POND_FPM_CONFIG@
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/respawn-pond /var/lib/respawn-pond
ReadOnlyPaths=/etc/respawn-pond /opt/respawn-pond

[Install]
WantedBy=multi-user.target