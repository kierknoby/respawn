[respawn-pond]
user = respawn-pond
group = www-data
listen = /run/respawn-pond/php-fpm.sock
listen.group = www-data
listen.mode = 0660
pm = static
pm.max_children = 2
clear_env = yes
catch_workers_output = yes
env[RESPAWN_POND_STATE] = /var/lib/respawn-pond/state
env[RESPAWN_POND_KEY] = /etc/respawn-pond/master.key
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_flag[expose_php] = off
php_admin_value[memory_limit] = 64M