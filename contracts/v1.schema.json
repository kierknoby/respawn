{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://respawn.in1.click/contracts/v1.schema.json",
  "title": "Respawn experimental public contract vocabulary v1",
  "$comment": "No proprietary endpoints. PHP Blueprint and Configuration validators are the current executable subset. External-service envelopes are specifications, not implemented transport.",
  "oneOf": [{"$ref":"#/$defs/providerConfig"},{"$ref":"#/$defs/blueprint"},{"$ref":"#/$defs/operationRequest"},{"$ref":"v2.schema.json"}],
  "$defs": {
    "identity": {"type":"string","pattern":"^[a-zA-Z0-9._:-]{1,128}$"},
    "providerConfig": {
      "type":"object","additionalProperties":false,
      "required":["schema","adapterId","endpoint","credentialRef","sourcePbxId","allowedHosts"],
      "properties": {
        "schema":{"const":"respawn.provider-config.v1"},"adapterId":{"$ref":"#/$defs/identity"},
        "endpoint":{"type":"string","format":"uri","pattern":"^https://","maxLength":2048},
        "credentialRef":{"type":"string","pattern":"^/","maxLength":256},
        "sourcePbxId":{"$ref":"#/$defs/identity"},"allowedHosts":{"type":"array","items":{"type":"string"},"minItems":1}
      }
    },
    "operationRequest": {
      "type":"object","additionalProperties":false,
      "required":["pbxId","blueprintId","blueprintVersion","intent","activationPolicy","idempotencyKey","requestedCapabilities"],
      "properties": {
        "pbxId":{"$ref":"#/$defs/identity"},"blueprintId":{"$ref":"#/$defs/identity"},
        "blueprintVersion":{"type":"integer","minimum":1},"intent":{"enum":["rehearsal","standby","recovery"]},
        "activationPolicy":{"enum":["none","manual"]},"idempotencyKey":{"type":"string","pattern":"^[a-zA-Z0-9._:-]{16,128}$"},
        "requestedCapabilities":{"type":"array","items":{"$ref":"#/$defs/identity"},"maxItems":64,"uniqueItems":true}
      },
      "allOf":[{"if":{"properties":{"intent":{"enum":["rehearsal","standby"]}}},"then":{"properties":{"activationPolicy":{"const":"none"}}}}]
    },
    "operation": {
      "type":"object","required":["operationId","pbxId","state","revision","updatedAt","resources","milestones"],
      "properties": {
        "operationId":{"$ref":"#/$defs/identity"},"pbxId":{"$ref":"#/$defs/identity"},
        "state":{"enum":["submitted","accepted","provisioning","configuration","connectivity","routing_prepared","ready","activating","active","cancelling","cancelled","tearing_down","teardown_partial","torn_down","failed","unknown","rollback_pending","rolled_back"]},
        "revision":{"type":"integer","minimum":1},"updatedAt":{"type":"string","format":"date-time"},
        "resources":{"type":"array","items":{"$ref":"#/$defs/resource"}},"milestones":{"type":"object"}
      }
    },
    "resource": {
      "type":"object","required":["id","owner","shared","state","dependsOn"],
      "properties":{"id":{"type":"string"},"owner":{"$ref":"#/$defs/identity"},"shared":{"type":"boolean"},"state":{"type":"string"},"dependsOn":{"type":"array","items":{"type":"string"}}}
    },
    "error": {
      "type":"object","required":["code","stage","retryable","message","correlationId"],
      "properties":{"code":{"type":"string"},"stage":{"type":"string"},"retryable":{"type":"boolean"},"message":{"type":"string","maxLength":1024},"correlationId":{"$ref":"#/$defs/identity"}}
    },
    "operationInstruction": {
      "type":"object","additionalProperties":false,"required":["id","adapter","action","dependsOn","parameters"],
      "properties": {
        "id":{"type":"string","pattern":"^ringgroup:[0-9]{2,8}$"},"adapter":{"const":"ringgroups.v1"},"action":{"const":"ensure"},
        "dependsOn":{"type":"array","maxItems":1,"items":{"type":"string","pattern":"^ringgroup:[0-9]{2,8}$"}},
        "parameters":{
          "type":"object","additionalProperties":false,"required":["number","description","strategy","timeout","members","destination"],
          "properties":{"number":{"type":"string","pattern":"^[0-9]{2,8}$"},"description":{"type":"string","pattern":"^[a-zA-Z0-9 ._-]{1,64}$"},"strategy":{"const":"ringall"},"timeout":{"type":"integer","minimum":1,"maximum":120},"members":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9]{2,8}$"}},"destination":{"type":"string","pattern":"^(hangup|[0-9]{2,8})$"}}
        }
      }
    },
    "blueprint": {
      "type":"object","additionalProperties":false,"required":["schema","sourcePbxId","compatibility","operations","coverage","contentHash"],
      "properties": {
        "schema":{"const":"respawn.reconstruction.v1"},"sourcePbxId":{"$ref":"#/$defs/identity"},
        "compatibility":{"const":{"freepbx":"17","ringgroups":"17"}},
        "operations":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/operationInstruction"}},
        "coverage":{"type":"object","required":["supported","gaps"],"properties":{"supported":{"type":"array","items":{"type":"string"}},"gaps":{"type":"array","items":{"type":"string"}}}},
        "contentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    }
  }
}